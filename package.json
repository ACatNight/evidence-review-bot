{
  "name": "evidence-review-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:api": "npm run build && node dist/src/entrypoints/api.js",
    "start:worker": "npm run build && node dist/src/entrypoints/worker.js",
    "worker:once": "npm run build && node dist/src/entrypoints/worker.js --once",
    "db:migrate": "npm run build && node dist/src/entrypoints/migrate.js",
    "inspect:queue": "npm run build && node dist/src/entrypoints/inspect-queue.js",
    "gitee:review": "npm run build && node dist/src/entrypoints/gitee-review.js",
    "github:review": "npm run build && node dist/src/entrypoints/github-review.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src test package.json tsconfig.json biome.json",
    "format": "biome check --write src test package.json tsconfig.json biome.json",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "openai": "7.25.0",
    "pg": "8.23.1",
    "zod": "4.6.5"
  }
}
