{
  "name": "evidence-review-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "evidence-review": "dist/src/entrypoints/cli.js"
  },
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:api": "npm run build && node dist/src/entrypoints/api.js",
    "start:worker": "npm run build && node dist/src/entrypoints/worker.js",
    "worker:once": "npm run build && node dist/src/entrypoints/worker.js --once",
    "db:migrate": "npm run build && node dist/src/entrypoints/migrate.js",
    "inspect:queue": "npm run build && node dist/src/entrypoints/inspect-queue.js",
    "gitee:review": "npm run build && node dist/src/entrypoints/gitee-review.js",
    "github:review": "npm run build && node dist/src/entrypoints/github-review.js",
    "demo:report": "npm run build && node dist/src/entrypoints/demo-report.js",
    "demo:protocol": "npm run build && node dist/src/entrypoints/demo-report.js json",
    "review": "npm run --silent build 1>&2 && node dist/src/entrypoints/cli.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint src test package.json tsconfig.json biome.json",
    "format:check": "biome format src test package.json tsconfig.json biome.json",
    "format": "biome format --write src test package.json tsconfig.json biome.json",
    "audit": "npm audit --package-lock-only --audit-level=high --registry=https://registry.npmjs.org",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "verify": "npm run format:check && npm run lint && npm run check && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "openai": "7.25.0",
    "pg": "8.23.1",
    "zod": "4.6.5"
  }
}
